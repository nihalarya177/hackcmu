{
  "name": "@trip/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --conditions=development src/http/dev.ts",
    "dev:worker": "tsx watch --conditions=development src/jobs/main.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@supabase/supabase-js": "2.116.0",
    "@trip/contracts": "*",
    "@trip/db": "*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.5",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "tsx": "4.23.13"
  }
}
