# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below is a placeholder: no real credential belongs in this file.

# ---------------------------------------------------------------------------
# Browser bundle (apps/web). Only public values may carry the VITE_ prefix.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Leave empty for the same-origin /api used locally and on Vercel.
VITE_API_BASE_URL=
# Optional. Basemap tiles for the map. Free key from carto.com/basemaps.
# Public by nature: the browser fetches tiles directly. Without it the map
# falls back to plain OpenStreetMap tiles.
VITE_CARTO_API_KEY=

# ---------------------------------------------------------------------------
# HTTP API (apps/server, deployed as the Vercel function).
# Uses the restricted trip_api role on the Supabase transaction pooler (6543).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://trip_api_user:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
ALLOWED_ORIGINS=http://localhost:5173
APP_REVISION=dev
# PORT=3000
# API_MAX_BODY_BYTES=65536
# DB_POOL_MAX=3
# DB_STATEMENT_TIMEOUT_MS=8000

# Only set these if live interactive place search is enabled on the API.
# PLACES_ENABLED=false
# GEOAPIFY_API_KEY=

# ---------------------------------------------------------------------------
# Local worker (apps/server jobs entry point). Never deployed to Vercel.
# Uses the restricted trip_worker role on a session/direct connection (5432).
# ---------------------------------------------------------------------------
DATABASE_URL_WORKER=postgresql://trip_worker_user:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
LLM_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.5-flash-lite
PLACES_ENABLED=true
GEOAPIFY_API_KEY=your-geoapify-key
# normal | demo
PROCESSING_MODE=normal
LLM_DAILY_REQUEST_LIMIT=200
PLACES_DAILY_REQUEST_LIMIT=300
# WORKER_ID=

# ---------------------------------------------------------------------------
# Migrations. A separate privileged credential, used only as a deployment step.
# ---------------------------------------------------------------------------
MIGRATION_DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Integration tests. A throwaway database only; never the shared demo project.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/trip_test
